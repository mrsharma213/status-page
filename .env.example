# Names only. Leave values empty in git. Set them in Vercel Production
# and in HQ. Never commit values. Never expose these through a browser-public
# environment variable.

# Auth.js session encryption. At least 32 characters.
AUTH_SECRET=

# Owner password for the browser session. At least 16 characters.
# Not a short PIN. Distinct from every other secret.
OWNER_PASSWORD=

# Machine ingest bearer. At least 32 characters.
# Does not create a browser session.
INGEST_SECRET=

# Set by a connected private Vercel Blob store (preferred, with OIDC).
BLOB_STORE_ID=

# Token fallback only if the project is not using Blob OIDC.
BLOB_READ_WRITE_TOKEN=

# Set by Vercel when Protection Bypass for Automation is enabled.
# The app never sends this to the browser. Collectors send it only as
# the x-vercel-protection-bypass header, from a server, never as a query
# parameter and never with x-vercel-set-bypass-cookie.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional. Defaults to America/New_York.
DISPLAY_TIMEZONE=America/New_York

# Optional comma-separated HTTPS host allowlist for evidence links.
EVIDENCE_HOST_ALLOWLIST=

# Optional canonical origin after the domain is attached.
# Leave unset until DNS cutover.
AUTH_URL=

# Local design review only. Never set either flag on Vercel.
# Both must be the string true, and VERCEL / VERCEL_ENV must be unset.
ALLOW_SYNTHETIC_DEMO=
ALLOW_SYNTHETIC_DEMO_LOCAL=
